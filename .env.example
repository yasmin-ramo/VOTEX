# Copy to .env — required in production
NODE_ENV=production
SESSION_SECRET=change-me-to-a-long-random-string      # openssl rand -hex 32
ADMIN_USER=admin
ADMIN_PASSWORD=change-me                               # only used to create the first admin
TRUST_PROXY=1                                          # set when behind nginx/Caddy/Cloudflare so real client IPs are used

# SMS provider: any vendor behind a webhook that accepts {"to","text"} with a Bearer token
SMS_WEBHOOK=
SMS_TOKEN=

# Optional
SEED_DEMO=0                  # 1 = load the 12 sample exhibitors + 3 categories into an empty DB
OTP_TTL_MS=300000
RL_IP_PER_MIN=6000           # per-IP request ceiling (high on purpose: the whole venue may share one IP)
RL_REGISTER_PER_IP=600       # per-IP registrations per 10 min
